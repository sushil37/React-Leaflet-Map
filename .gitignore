# Generated builds, test output, caches, and packed npm artifacts
dist/
build/
coverage/
.vite/
.cache/
*.tsbuildinfo
*.tgz

# Local configuration (keep example environment files shareable)
.env
.env.*
!.env.example
!.env.*.example

# Logs and operating-system files
*.log
.DS_Store
Thumbs.db
