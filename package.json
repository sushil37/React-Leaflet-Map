{
  "name": "lightweight-leaflet-map",
  "version": "1.0.1",
  "description": "A lightweight Leaflet map starter for browser apps, with draggable markers, location picking, coordinate popups, and configurable tile layers.",
  "author": {
    "name": "Sushil Shrestha",
    "email": "sushil.shrestha3000@gmail.com"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && vite build --config vite.lib.config.js && vite build --config vite.lib.config.js --mode standalone",
    "preview": "vite preview",
    "test": "vitest run",
    "prepack": "npm test && npm run build"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "jsdom": "^30.1.3",
    "leaflet": "^1.9.4"
  },
  "type": "module",
  "license": "MIT",
  "main": "./dist/lib/leaflet-map.js",
  "module": "./dist/lib/leaflet-map.js",
  "exports": {
    ".": {
      "import": "./dist/lib/leaflet-map.js"
    },
    "./style.css": "./dist/lib/leaflet-map.css",
    "./standalone": "./dist/lib/leaflet-map.global.js"
  },
  "files": [
    "dist/lib",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "sideEffects": [
    "**/*.css",
    "./example.js"
  ],
  "keywords": [
    "leaflet",
    "leaflet-map",
    "leaflet-starter",
    "map",
    "maps",
    "map-starter",
    "location-picker",
    "draggable-markers",
    "geolocation",
    "vanilla-js",
    "javascript",
    "browser",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushil37/leaflet-map-starter.git"
  },
  "bugs": {
    "url": "https://github.com/sushil37/leaflet-map-starter/issues"
  },
  "homepage": "https://sushil37.github.io/leaflet-map-starter/",
  "peerDependencies": {
    "leaflet": "^1.9.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
