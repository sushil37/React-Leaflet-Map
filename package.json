{
  "name": "lightweight-leaflet-map",
  "version": "1.0.0",
  "description": "A small, framework-independent wrapper for easy Leaflet maps, draggable locations, and coordinate popups.",
  "author": {
    "name": "Sushil Shrestha",
    "email": "sushil.shrestha3000@gmail.com"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && vite build --config vite.lib.config.js && vite build --config vite.lib.config.js --mode standalone",
    "preview": "vite preview",
    "test": "vitest run",
    "prepack": "npm test && npm run build"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "jsdom": "^30.1.3",
    "leaflet": "^1.9.4"
  },
  "type": "module",
  "license": "MIT",
  "main": "./dist/lib/leaflet-map.js",
  "module": "./dist/lib/leaflet-map.js",
  "exports": {
    ".": {
      "import": "./dist/lib/leaflet-map.js"
    },
    "./style.css": "./dist/lib/leaflet-map.css",
    "./standalone": "./dist/lib/leaflet-map.global.js"
  },
  "files": [
    "dist/lib",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "sideEffects": [
    "**/*.css",
    "./example.js"
  ],
  "keywords": [
    "leaflet",
    "map",
    "wrapper",
    "javascript",
    "location"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushil37/lightweight-leaflet-map.git"
  },
  "bugs": {
    "url": "https://github.com/sushil37/lightweight-leaflet-map/issues"
  },
  "homepage": "https://github.com/sushil37/lightweight-leaflet-map#readme",
  "peerDependencies": {
    "leaflet": "^1.9.4"
  }
}
